# Copy to frontend/.env.local for `npm run dev`
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Playwright e2e (`npm run e2e`): Clerk test user with a password, member of an organization.
# Set them here or in the repo-root .env (blank values are ignored by playwright.config.ts).
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
