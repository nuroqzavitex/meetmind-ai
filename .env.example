# Copy this file to `.env` in the repo root (same folder as this file) and fill in the values.
# `.env` is git-ignored — never commit real keys.

# ─── Used now (Plan 1: AI core + evals) ──────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Backend (Plan 2+: FastAPI, Postgres, Redis, Clerk) ──────────────────────
# Hosts `db` / `redis` are the docker-compose service names; use `localhost` when running outside Docker.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/meeting
REDIS_URL=redis://redis:6379
CLERK_JWKS_URL=https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-frontend-api>.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# The backend also reads CLERK_SECRET_KEY (below) to approve join requests via the Clerk API.
# anthropic | openai | ollama | fake  (openai cần OPENAI_API_KEY và model OpenAI ở LLM_MODEL_*, ví dụ gpt-5-mini;
# ollama = Ollama Cloud, cần OLLAMA_API_KEY và model như gemma4:31b ở LLM_MODEL_*;
# fake chỉ dùng cho e2e: trả lời từ file fixture, không gọi LLM thật)
LLM_PROVIDER=anthropic
# Mặc định ../tests/fixtures/llm/payment_v2 (tính từ backend/). Đừng để trống: giá trị rỗng ghi đè mặc định.
# FAKE_LLM_DIR=../tests/fixtures/llm/payment_v2
LLM_MODEL_DEFAULT=claude-sonnet-5-5
LLM_MODEL_ARBITRATE=claude-opus-5-5
PROMPT_VERSION=v1
CORS_ORIGINS=http://localhost:3000
# Discord notifications: links point here; CRON_SECRET guards POST /api/v1/internal/digest
FRONTEND_URL=http://localhost:3000
CRON_SECRET=
# Discord /hoi bot: Application ID and Public Key from the Developer Portal; the bot token is only
# needed to run backend/scripts/register_discord_commands.py once.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
MAX_UPLOAD_BYTES=5000000
# Upload ghi âm: chuyển giọng nói + tách người nói bằng OpenAI (cần OPENAI_API_KEY). OpenAI giới hạn 25 MB/file.
MAX_AUDIO_BYTES=25000000
STT_MODEL=gpt-4o-transcribe-diarize
# Giây giữa hai lần worker hỏi Redis có job mới. Tăng lên (vd 10) khi Redis tính theo số lệnh (Upstash free).
WORKER_POLL_DELAY=0.5
# Only used by the DB tests (host-side); default shown.
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/meeting_test

# ─── Q&A (Plan 4: embeddings) ────────────────────────────────────────────────
# local  = BAAI/bge-m3 via sentence-transformers (tải ~2 GB lần đầu)
# gemini = Gemini API, không tải model: đặt EMBEDDING_MODEL=gemini-embedding-001 và GEMINI_API_KEY
# hash   = không tải model, chất lượng thấp hơn (test, e2e)
# Đổi provider sau khi đã index thì phải phát hành lại các cuộc họp để index lại.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
GEMINI_API_KEY=
# docker compose: false = image backend/worker không cài torch (dùng với gemini hoặc hash)
INSTALL_EMBEDDINGS=true

# ─── Optional ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Ollama Cloud (LLM_PROVIDER=ollama), key ở https://ollama.com/settings/keys
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1
LANGFUSE_HOST=

# ─── Frontend (Plan 3: Next.js + Clerk) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
